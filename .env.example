# Copy to .env and fill in. Never commit .env.
PORT=4000
PROD_ENV=Development
MONGODBURL=

# Auth0 (see docs/AUTH.md)
ISSUERBASEURL=https://your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.friendwave
# Public URL of this API, used in image links (default http://localhost:PORT)
# API_URL=http://localhost:4000

# Dev only: test application for `npm run token`. Never set these on Render.
# AUTH0_TEST_CLIENT_ID=
# AUTH0_TEST_CLIENT_SECRET=

# AWS S3 (bucket/region are optional, defaults shown)
AWS_ACCESS_KEY=
AWS_SECRET_ACCESS_KEY=
# AWS_BUCKET=fwstorage-trial
# AWS_REGION=eu-west-2

# Browser origin allowed to call the API/socket (default *), e.g. your Next.js app
# CLIENT_ORIGIN=http://localhost:3000

# Requests per minute per IP on /api (default 300)
# RATE_LIMIT_PER_MINUTE=300

# Only for scripts/link-accounts.mjs: an M2M app for the Auth0 Management API
# AUTH0_MGMT_CLIENT_ID=
# AUTH0_MGMT_CLIENT_SECRET=
