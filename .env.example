# Copy to .env and fill in. Never commit .env.
PORT=3000
PROD_ENV=Development
MONGODBURL=

# Auth0
AUTH0SECRET=
AUTH0BASEURL=http://localhost:3000
AUTH0CLIENTID=
ISSUERBASEURL=

# Secret used to sign the app's JWTs
JWTKEY=

# AWS S3 (bucket/region are optional, defaults shown)
AWS_ACCESS_KEY=
AWS_SECRET_ACCESS_KEY=
# AWS_BUCKET=fwstorage-trial
# AWS_REGION=eu-west-2

# Browser origin allowed to call the API/socket (default *)
# CLIENT_ORIGIN=http://localhost:5173
